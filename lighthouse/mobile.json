{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-compressed.mjs",
      "startServerReadyPattern": "Serving compressed",
      "url": [
        "http://127.0.0.1:3000/",
        "http://127.0.0.1:3000/about/",
        "http://127.0.0.1:3000/services/compounding/",
        "http://127.0.0.1:3000/prescriptions/transfer/",
        "http://127.0.0.1:3000/contact/",
        "http://127.0.0.1:3000/squamish-pharmacy/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-reports/mobile"
    }
  }
}
